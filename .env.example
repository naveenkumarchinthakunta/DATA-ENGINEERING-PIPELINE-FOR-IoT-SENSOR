# Database Configuration
DATABASE_URL=sqlite:///data/iot_pipeline.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/iot_pipeline

# Pipeline Configuration
TOTAL_SENSORS=200
SIMULATION_BATCH_SIZE=200
SIMULATION_INTERVAL_SECONDS=5
ANOMALY_RATE=0.08
QUALITY_FAULT_RATE=0.05
REPORTING_WINDOW_MINUTES=5
STALE_SENSOR_THRESHOLD_MINUTES=10

# API Configuration
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=False

# Dashboard Configuration
DASHBOARD_PORT=8501
AUTO_REFRESH_SECONDS=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/pipeline.log
